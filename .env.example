# Copy to .env at the repo root; run.sh, install.sh and testflight.sh source it.

# Development server (Server/run.sh)
PORT=9047
SERVER_CODESIGN_IDENTITY=        # a stable identity keeps the macOS firewall allowance across rebuilds
REDIS_URL=                       # defaults to localhost
GEMINI_API_KEY=                  # optional: enables the @gemini bot
YOUTUBE_API_KEY=                 # optional: enables YouTube search in the picker
APNS_KEY_PEM=                    # optional, with the two below: enables pushes
APNS_KEY_ID=
APNS_TEAM_ID=

# Device builds (Apps/install.sh)
TOTEM_DEV_TEAM_ID=
TOTEM_DEVICE=                    # xcrun devicectl list devices
TOTEM_DEV_SERVER_URL=            # e.g. http://your-mac.local:9047

# TestFlight (Server/onboard/testflight.sh, testflight_submit.py)
TOTEM_TEAM_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
TOTEM_SERVER_URL=
TOTEM_TESTFLIGHT_APP_ID=
TOTEM_TESTFLIGHT_JOIN_CODE=
